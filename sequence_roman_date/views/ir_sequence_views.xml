<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_sequence_view_form_roman_date" model="ir.ui.view">
        <field name="name">ir.sequence.view.form.roman.date</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page/group[last()]" position="after">
                <group col="3" string="Additional Custom Legend (for prefix, suffix)">
                    <group>
                        <span colspan="2">Roman Month: %%(month_roman)s</span>
                        <span colspan="2">Roman Year: %%(year_roman)s</span>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
